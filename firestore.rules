rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 공개 댓글 — 누구나 읽고, 익명 로그인한 사람만 쓴다. 삭제는 쓴 사람(같은 uid)만.
    match /videos/{videoId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nickname', 'text', 't', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['nickname', 'text', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && (!('t' in request.resource.data) || request.resource.data.t == null
            || (request.resource.data.t is int && request.resource.data.t >= 0 && request.resource.data.t <= 86400))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 하이라이트 시청 기록 — 한 사람(uid)이 한 장면(시각)에 문서 하나. 문서 ID 가 "시각_uid" 라서 중복으로 못 쌓고,
    // 만든 뒤에는 고치거나 지울 수 없다. 읽기는 공개(개수 집계용).
    match /videos/{videoId}/hlViews/{viewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is int
        && request.resource.data.t >= 0 && request.resource.data.t <= 86400
        && viewId == string(request.resource.data.t) + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // 비공개 기록(IP·기기 정보) — 쓰기만 가능하고 아무도 읽을 수 없다. 관리자는 콘솔에서 확인.
    match /commentMeta/{commentId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['videoId', 'uid', 'ip', 'userAgent', 'platform', 'language', 'screen', 'timezone', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.ip == null || (request.resource.data.ip is string && request.resource.data.ip.size() <= 64))
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300;
      allow read, update, delete: if false;
    }
  }
}
