rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 음료수 당번 전용 계정 — src/drink/store.js 의 DRINK_EMAIL 과 같아야 한다
    function isDrinkUser() {
      return request.auth != null && request.auth.token.email == 'drink@wootang.kro.kr';
    }

    // 공개 댓글 — 누구나 읽고, 익명 로그인한 사람만 쓴다. 삭제는 쓴 사람(같은 uid)만.
    match /videos/{videoId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nickname', 'text', 't', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['nickname', 'text', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && (!('t' in request.resource.data) || request.resource.data.t == null
            || (request.resource.data.t is int && request.resource.data.t >= 0 && request.resource.data.t <= 86400))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 하이라이트 시청 기록 — 한 사람(uid)이 한 장면(시각)에 문서 하나. 문서 ID 가 "시각_uid" 라서 중복으로 못 쌓고,
    // 만든 뒤에는 고치거나 지울 수 없다. 읽기는 공개(개수 집계용).
    match /videos/{videoId}/hlViews/{viewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is int
        && request.resource.data.t >= 0 && request.resource.data.t <= 86400
        && viewId == string(request.resource.data.t) + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // 음료수 당번 (/drink/) — 멤버와 구매 기록을 문서 하나(drink/state)에 둔다.
    // 당번 전용 계정(이메일/비밀번호 로그인)으로 들어온 사람만 읽고 쓴다. 익명 로그인으로는 못 본다.
    match /drink/{docId} {
      allow read: if docId == 'state' && isDrinkUser();
      allow create, update: if docId == 'state' && isDrinkUser()
        && request.resource.data.keys().hasOnly(['members', 'history', 'updatedAt'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 100
        && request.resource.data.history is list && request.resource.data.history.size() <= 5000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 멤버 관리 (/members/) — 멤버 명단과 월별 부상 · 불참 · 기타 기록을 문서 하나(roster/state)에 둔다.
    // 음료수 당번과 같은 운영진 계정으로 들어온 사람만 읽고 쓴다 (부상 사유는 개인 건강 정보라 공개하지 않는다).
    match /roster/{docId} {
      allow read: if docId == 'state' && isDrinkUser();
      allow create, update: if docId == 'state' && isDrinkUser()
        && request.resource.data.keys().hasOnly(['members', 'months', 'updatedAt'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 300
        && request.resource.data.months is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 로고 후보 좋아요 (/logo/) — 한 사람(익명 uid)이 로고 하나에 문서 하나. 문서 ID 가 "uid__로고이름" 이라
    // 같은 로고에 두 번 못 누른다. 개수 집계를 위해 읽기는 공개, 지우기(취소)는 누른 사람만.
    match /logoLikes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['logo', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.logo is string
        && request.resource.data.logo.size() >= 1 && request.resource.data.logo.size() <= 150
        && likeId == request.auth.uid + '__' + request.resource.data.logo;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 비공개 기록(IP·기기 정보) — 쓰기만 가능하고 아무도 읽을 수 없다. 관리자는 콘솔에서 확인.
    match /commentMeta/{commentId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['videoId', 'uid', 'ip', 'userAgent', 'platform', 'language', 'screen', 'timezone', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.ip == null || (request.resource.data.ip is string && request.resource.data.ip.size() <= 64))
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300;
      allow read, update, delete: if false;
    }
  }
}
